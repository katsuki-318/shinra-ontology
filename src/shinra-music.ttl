    skos:notation "SHINRA_I001901" ; dcterms:created "2026-06-03"^^xsd:date .

shinra-data:sonata-form-001
    a shinra:MusicalForm ;
    rdfs:label "ソナタ形式"@ja ; rdfs:label "Sonata Form"@en ;
    shinra:wikidataId "Q182709" ;
    skos:notation "SHINRA_I001902" ; dcterms:created "2026-06-03"^^xsd:date .

shinra-data:jazz-001
    a shinra:MusicalGenre ;
    rdfs:label "ジャズ"@ja ; rdfs:label "Jazz"@en ;
    shinra:wikidataId "Q8341" ;
    skos:notation "SHINRA_I001903" ; dcterms:created "2026-06-03"^^xsd:date .

shinra-data:piano-001
    a shinra:MusicalInstrument ;
    rdfs:label "ピアノ"@ja ; rdfs:label "Piano"@en ;
    shinra:wikidataId "Q5994" ;
    skos:notation "SHINRA_I001904" ; dcterms:created "2026-06-03"^^xsd:date .

shinra-data:blues-scale-001
    a shinra:MusicalScale ;
    rdfs:label "ブルース音階"@ja ; rdfs:label "Blues Scale"@en ;
    shinra:wikidataId "Q849462" ;
    skos:notation "SHINRA_I001905" ; dcterms:created "2026-06-03"^^xsd:date .
