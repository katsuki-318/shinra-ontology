    skos:notation "SHINRA_I003101" ; dcterms:created "2026-06-03"^^xsd:date .

shinra-data:chinese-room-001
    a shinra:ThoughtExperiment ;
    rdfs:label "中国語の部屋"@ja ; rdfs:label "Chinese Room"@en ;
    shinra:wikidataId "Q275163" ;
    skos:notation "SHINRA_I003102" ; dcterms:created "2026-06-03"^^xsd:date .

shinra-data:dual-process-theory-001
    a shinra:PsychologicalTheory ;
    rdfs:label "二重過程理論"@ja ; rdfs:label "Dual Process Theory"@en ;
    shinra:wikidataId "Q1475501" ;
    skos:notation "SHINRA_I003103" ; dcterms:created "2026-06-03"^^xsd:date .
