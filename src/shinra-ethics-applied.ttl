    shinra:wikidataId "Q215369" ;
    skos:notation "SHINRA_I003402" ; dcterms:created "2026-06-03"^^xsd:date .

shinra-data:un-ai-ethics-001
    a shinra:EnvironmentalPolicy ;
    rdfs:label "UNESCO AI倫理勧告"@ja ; rdfs:label "UNESCO Recommendation on AI Ethics"@en ;
    shinra:wikidataId "Q108812426" ;
    skos:notation "SHINRA_I003403" ; dcterms:created "2026-06-03"^^xsd:date .
