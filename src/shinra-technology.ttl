    skos:notation "SHINRA_I001102" ; dcterms:created "2026-05-27"^^xsd:date .

shinra-data:solar-cell-001
    a shinra:RenewableEnergy ;
    rdfs:label "太陽電池"@ja ; rdfs:label "Solar Cell"@en ;
    shinra:wikidataId "Q189069" ;
    skos:notation "SHINRA_I001103" ; dcterms:created "2026-05-27"^^xsd:date .

shinra-data:penicillin-001
    a shinra:Drug ;
    rdfs:label "ペニシリン"@ja ; rdfs:label "Penicillin"@en ;
