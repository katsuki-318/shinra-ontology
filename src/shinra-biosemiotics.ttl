# ===========================================================================
# shinra-biosemiotics.ttl  — 生物記号論・記号過程ドメイン (Phase 10-c)
# ===========================================================================

@prefix shinra:      <https://w3id.org/shinra/ont/> .
@prefix shinra-data: <https://w3id.org/shinra/data/> .
@prefix owl:         <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:        <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:     <http://purl.org/dc/terms/> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/shinra/ont/biosemiotics>
    a owl:Ontology ;
    owl:versionInfo "0.5.0" ;
    owl:imports <https://w3id.org/shinra/ont/mid> ;
    dcterms:title   "神羅万象オントロジー — 生物記号論・記号過程ドメイン"@ja ,
                    "Shinra Ontology — Biosemiotics & Semiosis Domain"@en ;
    dcterms:created "2026-06-10"^^xsd:date .

shinra:Semiosis
    a owl:Class ; rdfs:subClassOf shinra:BiologicalProcess ;
    rdfs:label "記号過程"@ja ; rdfs:label "Semiosis"@en ;
    rdfs:comment "記号・意味・解釈の三項関係が機能する過程。生体内の遺伝コード・神経信号・免疫認識なども記号過程として解釈できる。"@ja ;
    rdfs:comment "The process in which the triadic relation of sign, meaning, and interpretation functions. Genetic code, neural signals, and immune recognition in organisms can also be interpreted as semiotic processes."@en ;
    skos:notation "SHINRA_0008401" ; dcterms:created "2026-06-10"^^xsd:date .

shinra:GeneticCode
    a owl:Class ; rdfs:subClassOf shinra:SignSystem ;
    rdfs:label "遺伝コード"@ja ; rdfs:label "Genetic Code"@en ;
    rdfs:comment "DNA・RNAの塩基配列をアミノ酸配列に翻訳する規則体系。コドン・アンチコドン・遺伝暗号表・コドン縮重など。"@ja ;
    rdfs:comment "The rule system translating DNA/RNA nucleotide sequences into amino acid sequences, including codons, anticodons, the genetic code table, and codon degeneracy."@en ;
    skos:notation "SHINRA_0008402" ; dcterms:created "2026-06-10"^^xsd:date .

shinra:AnimalCommunication
    a owl:Class ; rdfs:subClassOf shinra:Communication ;
    rdfs:label "動物コミュニケーション"@ja ; rdfs:label "Animal Communication"@en ;
    rdfs:comment "動物が情報を伝達・受信する行動。蜂のダンス・鳥の鳴き声・ホエザルの警戒声・クジラの歌など。"@ja ;
    rdfs:comment "Behaviors by which animals transmit and receive information, including honeybee dance language, birdsong, howler monkey alarm calls, and whale song."@en ;
    skos:notation "SHINRA_0008403" ; dcterms:created "2026-06-10"^^xsd:date .

shinra:Umwelt
    a owl:Class ; rdfs:subClassOf shinra:ConceptualEntity ;
    rdfs:label "環世界"@ja ; rdfs:label "Umwelt"@en ;
    rdfs:comment "ユクスキュルの概念。生物が主体として経験する固有の意味的環境世界。ダニの環世界・蜂の環世界など。"@ja ;
    rdfs:comment "Uexküll's concept of the species-specific meaningful environment a living being experiences as a subject, including the umwelt of ticks and bees."@en ;
    skos:notation "SHINRA_0008404" ; dcterms:created "2026-06-10"^^xsd:date .

shinra:BiologicalSignaling
    a owl:Class ; rdfs:subClassOf shinra:BiologicalProcess ;
    rdfs:label "生物学的シグナリング"@ja ; rdfs:label "Biological Signaling"@en ;
    skos:altLabel "細胞シグナル伝達"@ja ;
    rdfs:comment "細胞・組織・生物体内外での情報伝達過程。ホルモン・神経伝達物質・サイトカイン・細胞内シグナル経路など。"@ja ;
    rdfs:comment "The process of information transmission within and between cells, tissues, and organisms, including hormones, neurotransmitters, cytokines, and intracellular signaling pathways."@en ;
    skos:notation "SHINRA_0008405" ; dcterms:created "2026-06-10"^^xsd:date .

shinra-data:honeybee-dance-001
    a shinra:AnimalCommunication ;
    rdfs:label "ミツバチのダンス言語"@ja ; rdfs:label "Honeybee Dance Language"@en ;
    shinra:wikidataId "Q2320840" ;
    skos:notation "SHINRA_I008401" ; dcterms:created "2026-06-10"^^xsd:date .

shinra-data:dna-code-001
    a shinra:GeneticCode ;
    rdfs:label "DNA遺伝コード"@ja ; rdfs:label "DNA Genetic Code"@en ;
    shinra:wikidataId "Q7430" ;
    skos:notation "SHINRA_I008402" ; dcterms:created "2026-06-10"^^xsd:date .
