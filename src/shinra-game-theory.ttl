    a shinra:ScientificTheory ;
    rdfs:label "ナッシュの均衡定理"@ja ; rdfs:label "Nash Equilibrium Theorem"@en ;
    shinra:wikidataId "Q188522" ;
    skos:notation "SHINRA_I004201" ; dcterms:created "2026-06-03"^^xsd:date .

shinra-data:tragedy-of-commons-001
    a shinra:ThoughtExperiment ;
    rdfs:label "コモンズの悲劇"@ja ; rdfs:label "Tragedy of the Commons"@en ;
    shinra:wikidataId "Q471722" ;
    skos:notation "SHINRA_I004202" ; dcterms:created "2026-06-03"^^xsd:date .

shinra-data:deferred-acceptance-001
    a shinra:MechanismDesign ;
    rdfs:label "延期受入アルゴリズム"@ja ; rdfs:label "Deferred Acceptance Algorithm"@en ;
    shinra:wikidataId "Q1182159" ;
    skos:notation "SHINRA_I004203" ; dcterms:created "2026-06-03"^^xsd:date .
